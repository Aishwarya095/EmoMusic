# Built application files
*.apk
*.ap_
*.aab

# Don't ignore vendor libs
!app/libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
*/build/

# Gradle files
.gradle/
buildOutputCleanup/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Android Studio
proguard/

# Log files
*.log

# Android Studio / IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (Firebase) - keep private if added later
# google-services.json

# Keystore files
*.jks
*.keystore

# macOS & Windows system files
.DS_Store
Thumbs.db

# Documents & Project reports (kept private locally)
*.pdf
docs/
